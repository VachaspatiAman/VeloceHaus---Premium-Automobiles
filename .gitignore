# ============================================================
#  Veloce – .gitignore
# ============================================================

# Environment secrets – NEVER commit these
.env
.env.local
.env.production
.env.development
backend/.env

# Node modules
node_modules/
frontend/node_modules/
backend/node_modules/

# Next.js
frontend/.next/
frontend/out/

# Netlify
.netlify/

# Build artifacts
dist/
build/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo
