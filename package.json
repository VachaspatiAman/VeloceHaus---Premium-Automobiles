{
  "name": "veloce-ecommerce",
  "version": "1.0.0",
  "description": "VeloceHaus Automobile E-Commerce – monorepo root package",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend  && npm run dev",
    "dev": "netlify dev",
    "build": "cd frontend && npm run build",
    "build:check": "cd frontend && npm run build && echo '✅ Build successful'",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "deploy": "netlify deploy --prod",
    "deploy:preview": "netlify deploy",
    "lint": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "netlify-cli": "^17.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^20.19.41",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "serverless-http": "^3.2.0"
  }
}
