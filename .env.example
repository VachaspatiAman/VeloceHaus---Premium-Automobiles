# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars  # ← REQUIRED

# ── Environment ───────────────────────────────────────────
NODE_ENV=production        # production | development

# ── CORS  (comma-separated Netlify site URLs) ─────────────
# Leave empty to allow all origins (fine during development).
# Set to your Netlify URL in production:
#   CORS_ORIGIN=https://velocehaus.netlify.app
CORS_ORIGIN=

# ── Next.js public environment variables ──────────────────
# These are bundled into the frontend at build time.
# Prefix MUST be NEXT_PUBLIC_ to be accessible in the browser.
NEXT_PUBLIC_API_URL=/.netlify/functions/api    # local dev: http://localhost:5000
NEXT_PUBLIC_APP_NAME=VeloceHaus
NEXT_PUBLIC_APP_URL=https://velocehaus-premiumutomobiles.netlify.app/   # ← set to your Netlify URL

# ── Optional: Port for local Express dev (not used on Netlify) ──
PORT=5000
